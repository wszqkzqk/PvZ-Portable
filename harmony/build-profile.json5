{
  "app": {
    // Signing configs are machine-specific: generate one in DevEco Studio
    // (File > Project Structure > Signing Configs) and keep it out of git.
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // SDL3's HarmonyOS backend supports HarmonyOS 5.0.4 (API 16) and later.
        "compatibleSdkVersion": "5.0.4(16)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "nativeCompiler": "BiSheng",
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
